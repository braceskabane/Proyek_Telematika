<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/custom_background_home_daily_plan">
            <TextView
                style="@style/textStyleSemIBold_14"
                android:id="@+id/tvPushUp"
                android:layout_weight="0.5"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Push  up"
                android:textColor="@color/white" />

            <ImageView
                style="@style/textStyleSemIBold_14"
                android:id="@+id/ivStatusPushUp"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="0.1"
                android:src="@drawable/icon_done"
                android:gravity="end"
                android:layout_gravity="center_vertical"
                android:background="@null"
                android:paddingEnd="8dp"
                app:endIconMode="clear_text"
                android:inputType="text"
                app:tint="@color/green" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dark_grey"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp">
            <TextView
                style="@style/textStyleSemIBold_14"
                android:id="@+id/tvSetPushUp"
                android:layout_weight="0.5"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set"
                android:textColor="@color/white" />
            <EditText
                style="@style/textStyleSemIBold_14"
                android:id="@+id/etSetPushUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                android:hint="0"
                android:textColor="@color/dark_grey"
                android:textColorHint="@color/dark_grey"
                android:gravity="end"
                android:background="@null"
                android:paddingEnd="8dp"
                app:endIconMode="clear_text"
                android:inputType="number"/>
            <TextView
                style="@style/textStyleSemIBold_14"
                android:id="@+id/tvRepetitionsPushUp"
                android:layout_weight="0.5"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repetitions"
                android:textColor="@color/white" />

            <EditText
                style="@style/textStyleSemIBold_14"
                android:id="@+id/etRepetitionsPushUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                android:hint="0"
                android:textColor="@color/dark_grey"
                android:textColorHint="@color/dark_grey"
                android:gravity="end"
                android:background="@null"
                android:paddingEnd="8dp"
                app:endIconMode="clear_text"
                android:inputType="number"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>