<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/strava"
    tools:context=".view.otp.OtpActivity">

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvOtpTitle"
            style="@style/textStyleSemIBold_32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Verifikasi Kode"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOtpDescription"
            style="@style/textStyleSemIBold_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Masukkan kode 6 digit yang dikirim ke email Anda"
            android:textColor="@color/dark_grey" />

        <LinearLayout
            android:id="@+id/layoutOtpInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="64dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etOtp1"
                style="@style/textStyleSemIBold_32"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:background="@drawable/custom_navbar_background"
                android:inputType="number"
                android:layout_marginEnd="4dp"
                android:maxLength="1"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/etOtp2"
                style="@style/textStyleSemIBold_32"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/custom_navbar_background"
                android:inputType="number"
                android:maxLength="1"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/etOtp3"
                style="@style/textStyleSemIBold_32"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/custom_navbar_background"
                android:inputType="number"
                android:maxLength="1"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/etOtp4"
                style="@style/textStyleSemIBold_32"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/custom_navbar_background"
                android:inputType="number"
                android:maxLength="1"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/etOtp5"
                style="@style/textStyleSemIBold_32"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/custom_navbar_background"
                android:inputType="number"
                android:maxLength="1"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/etOtp6"
                style="@style/textStyleSemIBold_32"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/custom_navbar_background"
                android:inputType="number"
                android:maxLength="1"
                android:padding="12dp"
                android:textAlignment="center"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvOtpTimer"
                    style="@style/textStyleButton24"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="4dp"
                    android:gravity="end"
                    android:text="04:24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:gravity="start">

                <ImageButton
                    android:id="@+id/ivOtpRefresh"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:layout_gravity="start"
                    android:background="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_refresh" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOtpContinue"
        style="@style/LoginButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/custom_button_login"
        android:padding="4dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="@drawable/custom_btn_text_color"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>